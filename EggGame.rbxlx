	<Item class="ModuleScript" referent="RBX1">
		<Properties>
			<string name="Name">EggGameConfig</string>
			<ProtectedString name="Source"><![CDATA[--[[
	EggGameConfig — все числа баланса игры в одном месте.
	Хочешь игру быстрее/медленнее, дороже/дешевле — меняй только этот файл.

	Место в Studio: ReplicatedStorage -> ModuleScript с именем "EggGameConfig"
]]

local Config = {}

-- ===================== ЯЙЦА =====================

-- Сколько яиц одновременно лежит на рынке в центре карты
Config.MaxGroundEggs = 40

-- Как часто (в секундах) рынок пополняется новым яйцом
Config.SpawnInterval = 0.85

-- Сколько секунд яйца в рюкзаке нельзя украсть сразу после подбора
-- (чтобы вор не отбирал только что собранное)
Config.StealLockTime = 2.5

-- Размер и расположение стопки яиц над головой
Config.StackBaseHeight = 3.4   -- на сколько выше головы начинается стопка
Config.StackHeight = 1.85      -- расстояние между рядами
Config.StackBackOffset = 1.2   -- сдвиг назад от центра персонажа
Config.StackSpread = 1.55      -- расстояние между яйцами в ряду
Config.StackColumns = 3        -- яиц в ряду
Config.MaxVisibleStack = 15    -- больше не рисуем (остальные невидимы)

-- Во сколько раз уменьшаем яйцо в стопке и на складе
Config.CarriedEggScale = 0.7
Config.VaultEggScale = 0.55

-- Типы яиц: Weight — шанс выпадения, Value — цена и «сила» дохода
Config.EggTypes = {
	Common = {
		DisplayName = "Обычное",
		Weight = 70,
		Value = 1,
		Color = Color3.fromRGB(255, 245, 220),
		Size = Vector3.new(2.1, 2.1, 2.1),
		Rarity = Color3.fromRGB(235, 235, 235),
	},
	Rare = {
		DisplayName = "Редкое",
		Weight = 20,
		Value = 5,
		Color = Color3.fromRGB(110, 190, 255),
		Size = Vector3.new(2.2, 2.2, 2.2),
		Rarity = Color3.fromRGB(90, 170, 255),
	},
	Epic = {
		DisplayName = "Эпическое",
		Weight = 8,
		Value = 20,
		Color = Color3.fromRGB(185, 115, 255),
		Size = Vector3.new(2.35, 2.35, 2.35),
		Rarity = Color3.fromRGB(170, 90, 255),
	},
	Legendary = {
		DisplayName = "Легендарное",
		Weight = 2,
		Value = 100,
		Color = Color3.fromRGB(255, 190, 40),
		Size = Vector3.new(2.6, 2.6, 2.6),
		Rarity = Color3.fromRGB(255, 170, 30),
	},
}

-- ===================== КАРТА =====================

Config.ArenaSize = 400
Config.MarketRadius = 36
Config.BasesCount = 16
Config.BaseRingRadius = 134
Config.BaseZoneRadius = 15

-- ===================== ПОДБОР / КРАЖА =====================

-- Базовый радиус подбора яйца
Config.PickupRadius = 7


-- Пауза между кражами у одного игрока
Config.StealCooldown = 1.5

-- Сколько секунд держать кнопку, чтобы обокрасть другого игрока
Config.PlayerStealHoldTime = 0.9

-- Сколько секунд держать кнопку, чтобы обокрасть базу
Config.RaidHoldTime = 1.4

-- Урон/отбрасывание вора? нет — просто отбираем яйца

-- ===================== ЭКОНОМИКА =====================

-- Доход одного яйца в секунду = Value * IncomeRate
Config.IncomeRate = 0.14

-- Сколько секунд уходит на «занос» одного яйца в склад
Config.DepositTime = 0.22

-- Начальный капитал
Config.StartingCoins = 0


-- Начальная вместимость склада (без улучшений)
Config.VaultCapacityBase = 20

-- Вместимость склада при общем владении делится? нет — общая на базу

-- ===================== УЛУЧШЕНИЯ =====================

Config.Upgrades = {
	Backpack = {
		DisplayName = "Рюкзак",
		Description = "Больше яиц помещается за спиной",
		Icon = "🎒",
		BaseCost = 25,
		CostGrowth = 1.55,
		MaxLevel = 10,
		BaseValue = 3,
		PerLevel = 2,
		Unit = "яиц",
	},
	Speed = {
		DisplayName = "Скорость",
		Description = "Быстрее бегаешь — сложнее догнать",
		Icon = "⚡",
		BaseCost = 40,
		CostGrowth = 1.7,
		MaxLevel = 8,
		BaseValue = 16,
		PerLevel = 1.3,
		Unit = "",
	},
	Magnet = {
		DisplayName = "Магнит",
		Description = "Яйца подбираются с большего расстояния",
		Icon = "🧲",
		BaseCost = 60,
		CostGrowth = 1.8,
		MaxLevel = 6,
		BaseValue = 0,
		PerLevel = 1.7,
		Unit = "",
	},
	Steal = {
		DisplayName = "Ловкость",
		Description = "За одну кражу уносишь больше яиц",
		Icon = "🥷",
		BaseCost = 90,
		CostGrowth = 1.9,
		MaxLevel = 5,
		BaseValue = 1,
		PerLevel = 1,
		Unit = "яиц",
	},
	Vault = {
		DisplayName = "Склад",
		Description = "На базе помещается больше яиц",
		Icon = "🏦",
		BaseCost = 100,
		CostGrowth = 1.85,
		MaxLevel = 8,
		BaseValue = 20,
		PerLevel = 15,
		Unit = "яиц",
	},
	Income = {
		DisplayName = "Доход",
		Description = "Каждое яйцо на складе приносит больше",
		Icon = "💎",
		BaseCost = 120,
		CostGrowth = 1.95,
		MaxLevel = 8,
		BaseValue = 1,
		PerLevel = 0.2,
		Unit = "x",
	},
}

-- ===================== ПРОЧЕЕ =====================

Config.SaveFolder = "EggGamePlayerData"
Config.DataVersion = 1
Config.AutosaveInterval = 90

Config.Colors = {
	Floor = Color3.fromRGB(58, 66, 82),
	Wall = Color3.fromRGB(38, 44, 56),
	Market = Color3.fromRGB(255, 170, 60),
	MyBase = Color3.fromRGB(70, 230, 140),
	FreeBase = Color3.fromRGB(150, 160, 175),
	Vault = Color3.fromRGB(255, 205, 90),
	Text = Color3.fromRGB(255, 255, 255),
}

return Config
]]></ProtectedString>
			<bool name="IsPlugin">false</bool>
		</Properties>
	</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX8">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
	<Item class="Script" referent="RBX7">
		<Properties>
			<string name="Name">EggGameMain</string>
			<ProtectedString name="Source"><![CDATA[--[[
	EggGameMain — точка входа сервера.

	Место в Studio: ServerScriptService -> Script с именем "EggGameMain"
	ВАЖНО: это обычный Script (с иконкой «пьедестала»), а не LocalScript.

	Порядок работы:
	  1. Строит карту (EggGameMap)
	  2. Создаёт RemoteEvent'ы для клиента
	  3. Подключает игроков: данные, база, магазин
	  4. Запускает игровые циклы (EggGameCore)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("EggGameConfig"))

--[[
	Модули могут лежать двумя способами:
	  A) в папке EggGame внутри ServerScriptService  (как в готовом .rbxlx)
	  B) прямо в ServerScriptService                  (если копировал вручную)

	Ищем в обоих местах, чтобы игра запускалась при любой раскладке.
]]
local function findModule(name)
	-- 1. рядом со скриптом (папка EggGame)
	local sibling = script.Parent and script.Parent:FindFirstChild(name)
	if sibling then
		return sibling
	end

	-- 2. в папке EggGame внутри нашего контейнера
	local container = script.Parent
	local folder = container and container:FindFirstChild("EggGame")
	if folder then
		local inside = folder:FindFirstChild(name)
		if inside then
			return inside
		end
	end

	-- 3. где угодно в ServerScriptService (на случай нестандартной раскладки)
	local service = game:GetService("ServerScriptService")
	local anywhere = service:FindFirstChild(name, true)
	if anywhere then
		return anywhere
	end

	-- Не нашли — ждём с понятной ошибкой
	local waited = container and container:WaitForChild(name, 10)
	if waited then
		return waited
	end

	error(string.format(
		"Не найден модуль %s. Положи EggGameMap, EggGameData и EggGameCore " ..
		"в папку EggGame внутри ServerScriptService.", name
	), 0)
end

local Map = require(findModule("EggGameMap"))
local Data = require(findModule("EggGameData"))
local Core = require(findModule("EggGameCore"))

-- ============================================================
-- 1. КАРТА
-- ============================================================

local mapData = Map.build()

-- ============================================================
-- 2. REMOTES
-- ============================================================

local remotesFolder = ReplicatedStorage:FindFirstChild("EggGameRemotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "EggGameRemotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function ensureRemote(className, name)
	local existing = remotesFolder:FindFirstChild(name)
	if existing then
		return existing
	end
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = remotesFolder
	return remote
end

local remotes = {
	Notify = ensureRemote("RemoteEvent", "Notify"),
	CoinsUpdate = ensureRemote("RemoteEvent", "CoinsUpdate"),
	ShopUpdate = ensureRemote("RemoteEvent", "ShopUpdate"),
	CarriedUpdate = ensureRemote("RemoteEvent", "CarriedUpdate"),
	BaseInfo = ensureRemote("RemoteEvent", "BaseInfo"),
	BuyUpgrade = ensureRemote("RemoteFunction", "BuyUpgrade"),
	GetShop = ensureRemote("RemoteFunction", "GetShop"),
}

-- ============================================================
-- 3. ИГРОВАЯ ЛОГИКА
-- ============================================================

Core.init(mapData, remotes)

-- Оживляем мир: вращение статуи, мерцание костров, гирлянды
Map.startAnimations()

-- ============================================================
-- 4. МАГАЗИН
-- ============================================================

local function buildShopPayload(player)
	local entries = {}

	for upgradeName, upgradeConfig in pairs(Config.Upgrades) do
		table.insert(entries, {
			Name = upgradeName,
			DisplayName = upgradeConfig.DisplayName,
			Description = upgradeConfig.Description,
			Icon = upgradeConfig.Icon,
			Level = Data.getLevel(player, upgradeName),
			MaxLevel = upgradeConfig.MaxLevel,
			Cost = Data.getUpgradeCost(player, upgradeName),
			Value = Data.getUpgradeValue(player, upgradeName),
			Unit = upgradeConfig.Unit,
		})
	end

	table.sort(entries, function(a, b)
		local aCost = a.Cost or math.huge
		local bCost = b.Cost or math.huge
		if aCost == bCost then
			return a.DisplayName < b.DisplayName
		end
		return aCost < bCost
	end)

	return {
		Coins = Data.getCoins(player),
		Upgrades = entries,
	}
end

-- Обновление магазина на клиенте

local function syncShop(player)
	local remote = remotes.ShopUpdate
	if not remote or not player.Parent then
		return
	end
	if not Data.isLoaded(player) then
		return
	end
	remote:FireClient(player, buildShopPayload(player).Upgrades, Data.getCoins(player))
end

remotes.GetShop.OnServerInvoke = function(player)
	if not Data.isLoaded(player) then
		return nil
	end
	return buildShopPayload(player)
end

remotes.BuyUpgrade.OnServerInvoke = function(player, upgradeName)
	if type(upgradeName) ~= "string" then
		return false, "Неверный запрос"
	end

	if not Data.isLoaded(player) then
		return false, "Данные ещё грузятся"
	end

	local success, message = Data.purchaseUpgrade(player, upgradeName)

	if success then
		Core.syncCoins(player)
		Core.syncCarried(player)
		Core.syncBaseInfo(player)
		syncShop(player)
	else
		Core.notify(player, message, Color3.fromRGB(255, 140, 120))
	end

	return success, message
end

-- ============================================================
-- 5. ИГРОКИ
-- ============================================================

local function setupPlayer(player)
	Data.load(player)

	-- База
	Core.assignBase(player)

	-- Персонаж
	local function onCharacter(character)
		Core.onCharacterAdded(player, character)
	end

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	-- Отправляем стартовое состояние на клиент
	task.delay(0.6, function()
		if not player.Parent then
			return
		end
		Core.syncCoins(player)
		Core.syncCarried(player)
		Core.syncBaseInfo(player)
		syncShop(player)
		Core.notify(player, "Собирай яйца на рынке и неси на свою базу! 🥚", Color3.fromRGB(150, 230, 255))
	end)

	-- Периодическое обновление интерфейса
	task.spawn(function()
		while player.Parent do
			task.wait(1)
			if Data.isLoaded(player) then
				Core.syncCoins(player)
				Core.syncBaseInfo(player)
			end
		end
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(setupPlayer, player)
end

Players.PlayerRemoving:Connect(function(player)
	Core.cleanupPlayer(player)
	Data.release(player)
end)

-- Сохраняем всё при закрытии сервера
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			Data.save(player, true)
		end)
	end
	task.wait(2)
end)

Data.startAutosave()

-- ============================================================
-- 6. ОТЧЁТ В OUTPUT
-- ============================================================

print("================================================")
print("[EggGame] Сервер запущен")
print(string.format("[EggGame] Баз: %d | Яиц на рынке: %d", #mapData.BasesData, Config.MaxGroundEggs))
print("[EggGame] Сохранение: " .. (Data.isStoreAvailable() and "ВКЛЮЧЕНО" or "ВЫКЛЮЧЕНО (Studio -> Enable Studio Access to API Services)"))
print("================================================")
]]></ProtectedString>
			<bool name="IsPlugin">false</bool>
		</Properties>
	</Item>
	<Item class="Folder" referent="RBX6">
		<Properties>
			<string name="Name">EggGame</string>
		</Properties>
	<Item class="ModuleScript" referent="RBX3">
		<Properties>
			<string name="Name">EggGameMap</string>
			<ProtectedString name="Source"><![CDATA[--[[
	EggGameMap — строит весь мир игры кодом.

	Место в Studio: ServerScriptService -> ModuleScript "EggGameMap"

	МИР:
	  • Круглая арена с ландшафтом (трава, песок, камень)
	  • Рынок в центре: шатры, прилавки, фонари, статуя яйца
	  • 16 баз по кругу с заборами, ящиками и вывесками
	  • Горы по краям, деревья, камни, кусты
	  • Деревянный настил-дорога от рынка к базам
	  • Освещение, атмосфера, небо

	Всё создаётся из частей — никаких внешних моделей не нужно.
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("EggGameConfig"))

local Map = {}

-- Реестры объектов, которые анимируются: собираются при постройке,
-- крутятся в отдельном цикле (чтобы не плодить потоки)
Map.AnimatedFlames = {}
Map.AnimatedFires = {}
Map.AnimatedLanterns = {}
Map.Statue = nil

local RNG = Random.new()

-- ============================================================
-- ПАЛИТРА МИРА
-- ============================================================

local PALETTE = {
	GrassDark = Color3.fromRGB(64, 122, 62),
	GrassMid = Color3.fromRGB(84, 146, 76),
	GrassLight = Color3.fromRGB(104, 168, 88),
	Sand = Color3.fromRGB(206, 184, 132),
	SandDark = Color3.fromRGB(178, 154, 104),
	Stone = Color3.fromRGB(126, 128, 134),
	StoneDark = Color3.fromRGB(92, 94, 102),
	Rock = Color3.fromRGB(108, 110, 118),
	Dirt = Color3.fromRGB(128, 100, 72),
	DirtDark = Color3.fromRGB(100, 78, 56),
	Wood = Color3.fromRGB(124, 90, 58),
	WoodDark = Color3.fromRGB(88, 62, 40),
	WoodLight = Color3.fromRGB(158, 120, 78),
	RoofRed = Color3.fromRGB(168, 64, 54),
	RoofOrange = Color3.fromRGB(206, 112, 48),
	RoofBlue = Color3.fromRGB(62, 104, 158),
	Canvas = Color3.fromRGB(232, 218, 186),
	CanvasDark = Color3.fromRGB(198, 178, 142),
	Gold = Color3.fromRGB(255, 196, 64),
	LanternGlow = Color3.fromRGB(255, 212, 132),
	Water = Color3.fromRGB(78, 152, 196),
	LeafA = Color3.fromRGB(58, 138, 78),
	LeafB = Color3.fromRGB(96, 180, 108),
	LeafC = Color3.fromRGB(44, 112, 66),
}

-- ============================================================
-- ХЕЛПЕРЫ
-- ============================================================

local function newPart(props, parent)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	if parent then
		part.Parent = parent
	end
	return part
end

-- Часть с учётом формы: в Roblox шар/цилиндр масштабируются
-- по минимальной оси, поэтому размер приводим к корректному
local function shapePart(shape, diameter, height, props, parent)
	local part = newPart(props, parent)

	if shape == "Ball" then
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(diameter, diameter, diameter)
	elseif shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
		-- Цилиндр в Roblox «лежит» вдоль X
		part.Size = Vector3.new(height, diameter, diameter)
	else
		part.Shape = Enum.PartType.Block
		part.Size = Vector3.new(diameter, height, diameter)
	end

	return part
end

-- Плоский цилиндр, ось которого смотрит вверх (диск)
local function newDisc(props, parent)
	local part = newPart(props, parent)
	part.Shape = Enum.PartType.Cylinder

	local diameter = props.Radius and props.Radius * 2 or part.Size.Z
	local height = props.Height or 1

	part.Size = Vector3.new(height, diameter, diameter)
	part.CFrame = (props.CFrame or CFrame.new(props.Position or Vector3.new()))
		* CFrame.Angles(0, 0, math.rad(90))

	return part
end

local function makeBillboard(adornee, text, color, size, offset, font)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = size or UDim2.fromOffset(280, 46)
	gui.StudsOffset = offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.35
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.Text = text
	label.Parent = gui

	return gui, label
end

local function makePrompt(parent, actionText, objectText, distance, holdTime)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.MaxActivationDistance = distance or 10
	prompt.HoldDuration = holdTime or 0
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = parent
	return prompt
end

-- Точка на окружности
local function ringPoint(radius, angle, y)
	return Vector3.new(math.cos(angle) * radius, y or 0, math.sin(angle) * radius)
end

-- ============================================================
-- ЯЙЦО КАК ЧАСТЬ
-- ============================================================

function Map.makeEggPart(eggTypeName, parent)
	local eggType = Config.EggTypes[eggTypeName]
	if not eggType then
		eggTypeName = "Common"
		eggType = Config.EggTypes.Common
	end

	local diameter = math.max(eggType.Size.X, eggType.Size.Z)

	local part = newPart({
		Name = "Egg_" .. eggTypeName,
		Size = Vector3.new(diameter, diameter, diameter),
		Color = eggType.Color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, parent)

	-- Сфера + растяжение по Y = форма яйца
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.34, 1)
	mesh.Parent = part

	-- Блик, чтобы яйцо читалось объёмным
	local shine = Instance.new("Highlight")
	shine.FillColor = eggType.Color
	shine.FillTransparency = 0.82
	shine.OutlineTransparency = 1
	shine.DepthMode = Enum.HighlightDepthMode.Occluded
	shine.Parent = part

	if eggTypeName == "Epic" or eggTypeName == "Legendary" then
		local light = Instance.new("PointLight")
		light.Color = eggType.Color
		light.Range = (eggTypeName == "Legendary") and 16 or 10
		light.Brightness = (eggTypeName == "Legendary") and 2.2 or 1.2
		light.Parent = part
	end

	return part
end

function Map.randomPointInDisc(radius)
	local angle = RNG:NextNumber() * math.pi * 2
	local distance = math.sqrt(RNG:NextNumber()) * radius
	return Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
end

-- ============================================================
-- ЛАНДШАФТ
-- ============================================================

local function buildTerrain(folder)
	local size = Config.ArenaSize
	local half = size / 2

	-- Основание (плита под всем, чтобы не было дыр)
	local base = newPart({
		Name = "WorldBase",
		Size = Vector3.new(size + 60, 24, size + 60),
		Position = Vector3.new(0, -13, 0),
		Color = PALETTE.StoneDark,
		Material = Enum.Material.Rock,
		CanCollide = true,
	}, folder)

	-- Основное травяное поле
	local ground = newPart({
		Name = "Ground",
		Size = Vector3.new(size, 4, size),
		Position = Vector3.new(0, -2, 0),
		Color = PALETTE.GrassMid,
		Material = Enum.Material.Grass,
		CanCollide = true,
	}, folder)

	-- Пятна травы разных оттенков (для живости, без коллизий)
	for i = 1, 46 do
		local point = Map.randomPointInDisc(half - 12)
		local patchSize = 18 + RNG:NextNumber() * 42

		newDisc({
			Name = "GrassPatch",
			Radius = patchSize / 2,
			Height = 0.3,
			Position = Vector3.new(point.X, 0.12, point.Z),
			Color = (i % 3 == 0 and PALETTE.GrassLight)
				or (i % 3 == 1 and PALETTE.GrassDark)
				or PALETTE.GrassMid,
			Material = Enum.Material.Grass,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end

	-- Песчаная дорога-кольцо вокруг баз
	newDisc({
		Name = "RingRoad",
		Radius = Config.BaseRingRadius + 26,
		Height = 0.6,
		Position = Vector3.new(0, 0.2, 0),
		Color = PALETTE.SandDark,
		Material = Enum.Material.Sand,
		CanCollide = false,
		CanQuery = false,
	}, folder)

	-- Каменная площадь под рынком
	newDisc({
		Name = "MarketPlaza",
		Radius = Config.MarketRadius + 10,
		Height = 0.9,
		Position = Vector3.new(0, 0.3, 0),
		Color = PALETTE.Stone,
		Material = Enum.Material.Cobblestone,
		CanCollide = true,
	}, folder)

	-- Дорожки от рынка к каждой базе
	for i = 1, Config.BasesCount do
		local angle = ((i - 1) / Config.BasesCount) * math.pi * 2
		local from = Config.MarketRadius + 8
		local to = Config.BaseRingRadius - Config.BaseZoneRadius - 2
		local length = to - from
		local middle = (from + to) / 2

		local path = newPart({
			Name = "Path",
			Size = Vector3.new(9, 0.35, length),
			CFrame = CFrame.new(ringPoint(middle, angle, 0.28))
				* CFrame.Angles(0, -angle + math.pi / 2, 0),
			Color = PALETTE.Dirt,
			Material = Enum.Material.Ground,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end

	-- ===================== ГОРЫ ПО КРАЯМ =====================
	local mountainCount = 26
	for i = 1, mountainCount do
		local angle = (i / mountainCount) * math.pi * 2 + RNG:NextNumber() * 0.15
		local distance = half - RNG:NextNumber() * 26 - 8
		local point = ringPoint(distance, angle, 0)

		local height = 34 + RNG:NextNumber() * 56
		local width = 26 + RNG:NextNumber() * 26

		-- Основание горы
		shapePart("Cylinder", width, height, {
			Name = "Mountain",
			CFrame = CFrame.new(Vector3.new(point.X, height / 2 - 3, point.Z))
				* CFrame.Angles(0, RNG:NextNumber() * math.pi, math.rad(90)),
			Color = PALETTE.Rock:Lerp(PALETTE.StoneDark, RNG:NextNumber()),
			Material = Enum.Material.Rock,
			CanCollide = true,
		}, folder)

		-- Вершина (снег)
		shapePart("Ball", width * 0.55, width * 0.55, {
			Name = "Peak",
			Position = Vector3.new(point.X, height - 6, point.Z),
			Color = Color3.fromRGB(232, 238, 245),
			Material = Enum.Material.Snow,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end

	-- ===================== СТЕНЫ ПО ПЕРИМЕТРУ =====================
	-- Невысокие, чтобы не закрывать вид на горы
	local wallHeight = 26
	local wallThickness = 8
	local wallDefs = {
		{ Vector3.new(0, wallHeight / 2 - 1, -half - wallThickness / 2), Vector3.new(size + wallThickness * 2, wallHeight, wallThickness) },
		{ Vector3.new(0, wallHeight / 2 - 1, half + wallThickness / 2), Vector3.new(size + wallThickness * 2, wallHeight, wallThickness) },
		{ Vector3.new(-half - wallThickness / 2, wallHeight / 2 - 1, 0), Vector3.new(wallThickness, wallHeight, size) },
		{ Vector3.new(half + wallThickness / 2, wallHeight / 2 - 1, 0), Vector3.new(wallThickness, wallHeight, size) },
	}

	for index, def in ipairs(wallDefs) do
		newPart({
			Name = "BoundaryWall" .. index,
			Size = def[2],
			Position = def[1],
			Color = PALETTE.StoneDark,
			Material = Enum.Material.Rock,
			CanCollide = true,
		}, folder)
	end
end

-- ============================================================
-- РЫНОК
-- ============================================================

local function buildMarket(folder)
	local R = Config.MarketRadius

	-- Центральный постамент
	newDisc({
		Name = "PedestalBase",
		Radius = 7,
		Height = 3.2,
		Position = Vector3.new(0, 2, 0),
		Color = PALETTE.Stone,
		Material = Enum.Material.Marble,
		CanCollide = true,
	}, folder)

	newDisc({
		Name = "PedestalTop",
		Radius = 5.2,
		Height = 1.2,
		Position = Vector3.new(0, 4, 0),
		Color = PALETTE.StoneDark,
		Material = Enum.Material.Marble,
		CanCollide = true,
	}, folder)

	-- Статуя яйца
	local statue = Map.makeEggPart("Legendary", folder)
	statue.Name = "MarketStatue"
	statue.Size = Vector3.new(4.4, 4.4, 4.4)
	statue.Position = Vector3.new(0, 7.4, 0)

	-- Свечение вокруг статуи
	local statueLight = Instance.new("PointLight")
	statueLight.Color = PALETTE.Gold
	statueLight.Range = 40
	statueLight.Brightness = 3
	statueLight.Parent = statue

	Map.Statue = statue

	-- ===================== ШАТРЫ =====================
	local tentsCount = 8
	for i = 1, tentsCount do
		local angle = ((i - 1) / tentsCount) * math.pi * 2 + math.pi / tentsCount
		local point = ringPoint(R - 4, angle, 0)

		local tent = Instance.new("Model")
		tent.Name = "Tent_" .. i
		tent.Parent = folder

		-- основание
		newPart({
			Name = "Floor",
			Size = Vector3.new(15, 0.7, 15),
			CFrame = CFrame.new(point + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.WoodLight,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
		}, tent)

		-- 4 столба
		for pillar = 1, 4 do
			local offsetX = (pillar <= 2) and -6.2 or 6.2
			local offsetZ = (pillar % 2 == 1) and -6.2 or 6.2

			local local_ = CFrame.new(point) * CFrame.Angles(0, -angle, 0)

			newPart({
				Name = "Pillar",
				Size = Vector3.new(0.9, 12, 0.9),
				Position = (local_ * CFrame.new(offsetX, 6.4, offsetZ)).Position,
				Color = PALETTE.Wood,
				Material = Enum.Material.Wood,
				CanCollide = true,
			}, tent)
		end

		-- навес
		local canopyColors = { PALETTE.RoofRed, PALETTE.RoofOrange, PALETTE.RoofBlue }
		newPart({
			Name = "Canopy",
			Size = Vector3.new(16, 1.1, 16),
			CFrame = CFrame.new(point + Vector3.new(0, 12.6, 0)) * CFrame.Angles(0, -angle, 0),
			Color = canopyColors[(i % 3) + 1],
			Material = Enum.Material.Fabric,
			CanCollide = true,
		}, tent)

		-- верхушка навеса
		newPart({
			Name = "CanopyTop",
			Size = Vector3.new(9, 2.4, 9),
			CFrame = CFrame.new(point + Vector3.new(0, 14, 0)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.CanvasDark,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			CanQuery = false,
		}, tent)

		-- прилавок внутри
		newPart({
			Name = "Counter",
			Size = Vector3.new(7, 3, 2.2),
			CFrame = CFrame.new(point + Vector3.new(0, 3.4, 3.4)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.WoodDark,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
		}, tent)

		-- товар на прилавке (декоративные яйца)
		for item = 1, 3 do
			local egg = Map.makeEggPart(({ "Common", "Rare", "Epic" })[item], tent)
			egg.Anchored = true
			egg.Size = egg.Size * 0.42
			egg.Position = (CFrame.new(point + Vector3.new(0, 5.2, 3.4)) * CFrame.Angles(0, -angle, 0)
				* CFrame.new((item - 2) * 2, 0, 0)).Position
		end

		-- флажок
		newPart({
			Name = "Flag",
			Size = Vector3.new(3.4, 2, 0.3),
			CFrame = CFrame.new(point + Vector3.new(0, 16.4, 0)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.Gold,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			CanQuery = false,
		}, tent)
	end

	-- ===================== ФОНАРИ =====================
	local lanternCount = 12
	for i = 1, lanternCount do
		local angle = ((i - 1) / lanternCount) * math.pi * 2
		local point = ringPoint(R + 6, angle, 0)

		-- столб
		newPart({
			Name = "LanternPost",
			Size = Vector3.new(0.8, 13, 0.8),
			Position = point + Vector3.new(0, 6.5, 0),
			Color = PALETTE.StoneDark,
			Material = Enum.Material.Metal,
			CanCollide = true,
		}, folder)

		-- светильник
		local bulb = shapePart("Ball", 2.2, 2.2, {
			Name = "Lantern",
			Position = point + Vector3.new(0, 13.6, 0),
			Color = PALETTE.LanternGlow,
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, folder)

		local light = Instance.new("PointLight")
		light.Color = PALETTE.LanternGlow
		light.Range = 34
		light.Brightness = 1.8
		light.Shadows = true
		light.Parent = bulb

		table.insert(Map.AnimatedLanterns, bulb)
		table.insert(Map.AnimatedFires, light)
	end

	-- ===================== ГИРЛЯНДА =====================
	-- Провисающие лампочки между фонарями
	for i = 1, lanternCount do
		local angleA = ((i - 1) / lanternCount) * math.pi * 2
		local angleB = (i / lanternCount) * math.pi * 2

		local pointA = ringPoint(R + 6, angleA, 12.6)
		local pointB = ringPoint(R + 6, angleB, 12.6)

		local segments = 5
		for segment = 1, segments do
			local t1 = (segment - 1) / segments
			local t2 = segment / segments

			local function lerpDrop(t, point)
				local sag = math.sin(t * math.pi) * 1.8
				return point + Vector3.new(0, -sag, 0)
			end

			local a = pointA:Lerp(pointB, t1)
			local b = pointA:Lerp(pointB, t2)
			a = lerpDrop(t1, a)
			b = lerpDrop(t2, b)

			local middle = (a + b) / 2
			local length = (b - a).Magnitude

			local wire = newPart({
				Name = "Wire",
				Size = Vector3.new(length, 0.14, 0.14),
				CFrame = CFrame.new(middle, b),
				Color = PALETTE.StoneDark,
				Material = Enum.Material.Metal,
				CanCollide = false,
				CanQuery = false,
			}, folder)

			if segment == 3 then
				local bulb = shapePart("Ball", 0.85, 0.85, {
					Name = "Bulb",
					Position = a,
					Color = PALETTE.Gold,
					Material = Enum.Material.Neon,
					CanCollide = false,
					CanQuery = false,
				}, folder)

				table.insert(Map.AnimatedLanterns, bulb)
			end
		end
	end

	-- ===================== СПАВН =====================
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "PlayerSpawn"
	spawnLocation.Size = Vector3.new(18, 1.2, 18)
	spawnLocation.Position = Vector3.new(0, 1.4, 18)
	spawnLocation.Anchored = true
	spawnLocation.CanCollide = false
	spawnLocation.Transparency = 0.55
	spawnLocation.Color = PALETTE.Gold
	spawnLocation.Material = Enum.Material.Neon
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Parent = folder

	-- кольцо вокруг спавна
	newDisc({
		Name = "SpawnRing",
		Radius = 11,
		Height = 0.35,
		Position = Vector3.new(0, 0.85, 18),
		Color = PALETTE.Gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
	}, folder)
end

-- ============================================================
-- БАЗЫ
-- ============================================================

local function buildBases(folder)
	local bases = {}

	for index = 1, Config.BasesCount do
		local angle = ((index - 1) / Config.BasesCount) * math.pi * 2
		local center = ringPoint(Config.BaseRingRadius, angle, 0)
		local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local inward = -outward
		local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))

		local model = Instance.new("Model")
		model.Name = "Base_" .. index
		model.Parent = folder

		local zoneR = Config.BaseZoneRadius

		-- ===================== ПЛОЩАДКА =====================
		local platform = newDisc({
			Name = "Platform",
			Radius = zoneR + 2,
			Height = 1.2,
			Position = center + Vector3.new(0, 0.6, 0),
			Color = PALETTE.Sand,
			Material = Enum.Material.Sand,
			CanCollide = true,
		}, model)

		-- каменная окантовка
		local glow = newDisc({
			Name = "Glow",
			Radius = zoneR + 3.4,
			Height = 0.25,
			Position = center + Vector3.new(0, 0.8, 0),
			Color = Color3.fromRGB(180, 190, 200),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
		}, model)

		-- ===================== СКЛАД =====================
		-- деревянный стол
		newPart({
			Name = "VaultStand",
			Size = Vector3.new(11, 3.6, 11),
			CFrame = CFrame.new(center + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.DirtDark,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
		}, model)

		local vaultTop = newPart({
			Name = "VaultTop",
			Size = Vector3.new(10.4, 0.9, 10.4),
			CFrame = CFrame.new(center + Vector3.new(0, 4.9, 0)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.WoodLight,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
		}, model)

		local vaultGlow = newPart({
			Name = "VaultGlow",
			Size = Vector3.new(11.4, 0.3, 11.4),
			CFrame = CFrame.new(center + Vector3.new(0, 5.3, 0)) * CFrame.Angles(0, -angle, 0),
			Color = PALETTE.Gold,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
		}, model)

		local _, vaultLabel = makeBillboard(
			vaultTop, "🏦 0", Color3.fromRGB(255, 232, 156), UDim2.fromOffset(300, 52), Vector3.new(0, 3.6, 0)
		)

		local stealPrompt = makePrompt(vaultTop, "Украсть яйца", "Чужой склад", 13, Config.RaidHoldTime)

		-- ===================== ВЫВЕСКА =====================
		local signPos = center + inward * (zoneR - 1)

		newPart({
			Name = "SignPost",
			Size = Vector3.new(1.1, 15, 1.1),
			CFrame = CFrame.new(signPos + Vector3.new(0, 8, 0)),
			Color = PALETTE.WoodDark,
			Material = Enum.Material.Wood,
			CanCollide = true,
		}, model)

		local signBoard = newPart({
			Name = "SignBoard",
			Size = Vector3.new(15, 6, 0.9),
			CFrame = CFrame.new(signPos + Vector3.new(0, 16, 0), Vector3.new(0, signPos.Y + 16, 0)),
			Color = PALETTE.WoodDark,
			Material = Enum.Material.WoodPlanks,
			CanCollide = false,
		}, model)

		local _, signLabel = makeBillboard(
			signBoard, "Свободная база", Color3.new(1, 1, 1), UDim2.fromOffset(360, 74), Vector3.new(0, 0, 0.7)
		)

		-- ===================== ЗАБОР =====================
		local fenceSegments = 14
		for fence = 1, fenceSegments do
			local fenceAngle = (fence / fenceSegments) * math.pi * 2
			local fencePoint = center + Vector3.new(
				math.cos(fenceAngle) * (zoneR + 1.4),
				1.1,
				math.sin(fenceAngle) * (zoneR + 1.4)
			)

			-- оставляем проход со стороны рынка
			local toMarket = (Math and 0) or 0
			local angleToMarket = math.atan2(-center.Z, -center.X)
			local diff = math.abs(((fenceAngle - angleToMarket + math.pi) % (math.pi * 2)) - math.pi)

			if diff > 0.42 then
				newPart({
					Name = "FencePost",
					Size = Vector3.new(0.7, 3.4, 0.7),
					CFrame = CFrame.new(fencePoint),
					Color = PALETTE.WoodDark,
					Material = Enum.Material.Wood,
					CanCollide = false,
					CanQuery = false,
				}, model)
			end
		end

		-- ===================== ЯЩИКИ И БОЧКИ =====================
		for crate = 1, 3 do
			local side = (crate == 1) and 1 or -1
			local crateAngle = angle + side * (0.5 + crate * 0.12)
			local cratePoint = ringPoint(Config.BaseRingRadius + zoneR - 3, crateAngle, 0)

			if crate == 3 then
				-- бочка
				shapePart("Cylinder", 3.2, 4.2, {
					Name = "Barrel",
					CFrame = CFrame.new(cratePoint + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
					Color = PALETTE.WoodDeep or PALETTE.Wood,
					Material = Enum.Material.Wood,
					CanCollide = true,
				}, model)
			else
				newPart({
					Name = "Crate",
					Size = Vector3.new(3.4, 3.4, 3.4),
					CFrame = CFrame.new(cratePoint + Vector3.new(0, 2.5, 0))
						* CFrame.Angles(0, math.rad(crate * 24 + index * 13), 0),
					Color = PALETTE.Wood,
					Material = Enum.Material.WoodPlanks,
					CanCollide = true,
				}, model)
			end
		end

		-- ===================== КОСТЁР =====================
		local firePos = center + ringPoint(zoneR + 7, angle + 0.7, 0) - center
		firePos = center + Vector3.new(firePos.X, 0, firePos.Z)

		local fireBase = shapePart("Cylinder", 4.6, 0.9, {
			Name = "CampfireBase",
			CFrame = CFrame.new(firePos + Vector3.new(0, 0.7, 0)),
			Color = PALETTE.Stone,
			Material = Enum.Material.Cobblestone,
			CanCollide = false,
		}, model)

		local flame = shapePart("Ball", 1.9, 1.9, {
			Name = "Flame",
			Position = firePos + Vector3.new(0, 2.2, 0),
			Color = Color3.fromRGB(255, 146, 46),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
		}, model)

		local fireLight = Instance.new("PointLight")
		fireLight.Color = Color3.fromRGB(255, 156, 60)
		fireLight.Range = 26
		fireLight.Brightness = 2
		fireLight.Parent = flame

		-- поленья
		for log = 1, 4 do
			local logAngle = (log / 4) * math.pi * 2
			newPart({
				Name = "Log",
				Size = Vector3.new(1.1, 1.1, 4.6),
				CFrame = CFrame.new(firePos + Vector3.new(math.cos(logAngle) * 1.4, 1.2, math.sin(logAngle) * 1.4))
					* CFrame.Angles(math.rad(20), logAngle, 0),
				Color = PALETTE.WoodDark,
				Material = Enum.Material.Wood,
				CanCollide = false,
				CanQuery = false,
			}, model)
		end

			-- костёр регистрируем для анимации мерцания
		table.insert(Map.AnimatedFlames, flame)
		table.insert(Map.AnimatedFires, fireLight)

		-- ===================== МАРКЕР «МОЯ БАЗА» =====================
		local marker = shapePart("Ball", 6, 6, {
			Name = "MyBaseMarker",
			Position = center + Vector3.new(0, 44, 0),
			Color = Config.Colors.MyBase,
			Material = Enum.Material.Neon,
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		}, model)

		local markerGui = Instance.new("BillboardGui")
		markerGui.Name = "MarkerGui"
		markerGui.Size = UDim2.fromOffset(240, 58)
		markerGui.StudsOffset = Vector3.new(0, 6.5, 0)
		markerGui.AlwaysOnTop = true
		markerGui.MaxDistance = 900
		markerGui.LightInfluence = 0
		markerGui.Adornee = marker
		markerGui.Enabled = false
		markerGui.Parent = marker

		local markerLabel = Instance.new("TextLabel")
		markerLabel.Size = UDim2.fromScale(1, 1)
		markerLabel.BackgroundTransparency = 1
		markerLabel.Font = Enum.Font.GothamBlack
		markerLabel.Text = "МОЯ БАЗА"
		markerLabel.TextScaled = true
		markerLabel.TextColor3 = Config.Colors.MyBase
		markerLabel.TextStrokeTransparency = 0.15
		markerLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
		markerLabel.Parent = markerGui

		table.insert(bases, {
			Id = index,
			Model = model,
			Center = center,
			Platform = platform,
			Glow = glow,
			SignLabel = signLabel,
			VaultTop = vaultTop,
			VaultGlow = vaultGlow,
			VaultLabel = vaultLabel,
			StealPrompt = stealPrompt,
			Marker = marker,
			MarkerGui = markerGui,
			Owners = {},
			Vault = {},
			VaultTotal = 0,
			VisualEggs = {},
			RateAccum = {},
			IncomePerSecond = 0,
			FirePos = firePos,
		})
	end

	return bases
end

-- ============================================================
-- ПРИРОДА
-- ============================================================

local function buildTree(folder, position, scale)
	scale = scale or 1

	local trunkHeight = (9 + RNG:NextNumber() * 7) * scale
	local trunkWidth = (2.4 + RNG:NextNumber() * 1.2) * scale

	local tree = Instance.new("Model")
	tree.Name = "Tree"
	tree.Parent = folder

	-- ствол
	shapePart("Cylinder", trunkWidth, trunkHeight, {
		Name = "Trunk",
		CFrame = CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = PALETTE.Wood:Lerp(PALETTE.WoodDark, RNG:NextNumber()),
		Material = Enum.Material.Wood,
		CanCollide = true,
	}, tree)

	-- крона из 3 шаров
	local leafColors = { PALETTE.LeafA, PALETTE.LeafB, PALETTE.LeafC }

	for layer = 1, 3 do
		local layerSize = (10 - layer * 2.2 + RNG:NextNumber() * 1.6) * scale

		shapePart("Ball", layerSize, layerSize, {
			Name = "Leaves",
			Position = position + Vector3.new(
				(RNG:NextNumber() - 0.5) * 2.6 * scale,
				trunkHeight + (layer - 1) * 2.8 * scale - 1.6 * scale,
				(RNG:NextNumber() - 0.5) * 2.6 * scale
			),
			Color = leafColors[RNG:NextInteger(1, 3)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			CanQuery = false,
		}, tree)
	end

	return tree
end

local function buildNature(folder)
	local half = Config.ArenaSize / 2

	-- ===================== ДЕРЕВЬЯ =====================
	local treeCount = 52
	for i = 1, treeCount do
		local angle = RNG:NextNumber() * math.pi * 2
		local distance = Config.BaseRingRadius + Config.BaseZoneRadius + 16
			+ RNG:NextNumber() * (half - Config.BaseRingRadius - Config.BaseZoneRadius - 40)

		distance = math.min(distance, half - 22)
		local point = ringPoint(distance, angle, 0)

		buildTree(folder, point, 0.8 + RNG:NextNumber() * 0.7)
	end

	-- пара деревьев внутри кольца баз (для уюта)
	for i = 1, 8 do
		local point = Map.randomPointInDisc(Config.BaseRingRadius - Config.BaseZoneRadius - 14)
		if point.Magnitude > Config.MarketRadius + 12 then
			buildTree(folder, point, 0.7 + RNG:NextNumber() * 0.5)
		end
	end

	-- ===================== КАМНИ =====================
	for i = 1, 60 do
		local angle = RNG:NextNumber() * math.pi * 2
		local distance = Config.MarketRadius + 14 + RNG:NextNumber() * (half - Config.MarketRadius - 40)
		local point = ringPoint(distance, angle, 0)

		local rockSize = 2 + RNG:NextNumber() * 5
		shapePart("Ball", rockSize, rockSize, {
			Name = "Rock",
			CFrame = CFrame.new(point + Vector3.new(0, rockSize / 3, 0))
				* CFrame.Angles(RNG:NextNumber(), RNG:NextNumber(), RNG:NextNumber()),
			Color = PALETTE.Rock:Lerp(PALETTE.Stone, RNG:NextNumber()),
			Material = Enum.Material.Rock,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end

	-- ===================== КУСТЫ =====================
	for i = 1, 80 do
		local angle = RNG:NextNumber() * math.pi * 2
		local distance = Config.MarketRadius + 10 + RNG:NextNumber() * (half - Config.MarketRadius - 30)
		local point = ringPoint(distance, angle, 0)

		local bushSize = 1.8 + RNG:NextNumber() * 2.2
		shapePart("Ball", bushSize, bushSize, {
			Name = "Bush",
			CFrame = CFrame.new(point + Vector3.new(0, bushSize / 2.4, 0))
				* CFrame.Angles(RNG:NextNumber(), RNG:NextNumber(), RNG:NextNumber()),
			Color = PALETTE.LeafC:Lerp(PALETTE.LeafA, RNG:NextNumber()),
			Material = Enum.Material.Grass,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end

	-- ===================== ЦВЕТЫ =====================
	local flowerColors = {
		Color3.fromRGB(255, 120, 140),
		Color3.fromRGB(255, 216, 96),
		Color3.fromRGB(196, 132, 255),
		Color3.fromRGB(120, 200, 255),
		Color3.fromRGB(255, 255, 255),
	}

	for i = 1, 140 do
		local angle = RNG:NextNumber() * math.pi * 2
		local distance = Config.MarketRadius + 8 + RNG:NextNumber() * (half - Config.MarketRadius - 30)
		local point = ringPoint(distance, angle, 0)

		shapePart("Ball", 0.75, 0.75, {
			Name = "Flower",
			Position = point + Vector3.new(0, 1.1, 0),
			Color = flowerColors[RNG:NextInteger(1, #flowerColors)],
			Material = Enum.Material.Grass,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end

	-- ===================== ПРУД =====================
	local pondPos = Vector3.new(-Config.BaseRingRadius - 8, 0, Config.BaseRingRadius - 30)

	newDisc({
		Name = "PondEdge",
		Radius = 24,
		Height = 0.8,
		Position = pondPos + Vector3.new(0, 0.4, 0),
		Color = PALETTE.SandDark,
		Material = Enum.Material.Sand,
		CanCollide = false,
		CanQuery = false,
	}, folder)

	local pond = newDisc({
		Name = "PondWater",
		Radius = 21,
		Height = 0.5,
		Position = pondPos + Vector3.new(0, 0.55, 0),
		Color = PALETTE.Water,
		Material = Enum.Material.Glass,
		CanCollide = false,
		CanQuery = false,
	}, folder)
	pond.Transparency = 0.25

	-- камыши
	for i = 1, 12 do
		local a = RNG:NextNumber() * math.pi * 2
		local r = 19 + RNG:NextNumber() * 3
		newPart({
			Name = "Reed",
			Size = Vector3.new(0.34, 3 + RNG:NextNumber() * 2, 0.34),
			Position = pondPos + Vector3.new(math.cos(a) * r, 2, math.sin(a) * r),
			Color = PALETTE.LeafC,
			Material = Enum.Material.Grass,
			CanCollide = false,
			CanQuery = false,
		}, folder)
	end
end

-- ============================================================
-- Освещение и атмосфера
-- ============================================================

local function setupLighting()
	Lighting.Ambient = Color3.fromRGB(104, 110, 136)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 150, 180)
	Lighting.Brightness = 2.6
	Lighting.ClockTime = 14.6
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.45
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 1800
	Lighting.FogStart = 700
	Lighting.ShadowSoftness = 0.4

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = Lighting
	end
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.18
	atmosphere.Color = Color3.fromRGB(212, 220, 238)
	atmosphere.Decay = Color3.fromRGB(126, 148, 190)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.1

	-- Blur и Bloom делают картинку «дороже»
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if not bloom then
		bloom = Instance.new("BloomEffect")
		bloom.Parent = Lighting
	end
	bloom.Intensity = 0.55
	bloom.Size = 24
	bloom.Threshold = 1.05

	local colorCorrection = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	if not colorCorrection then
		colorCorrection = Instance.new("ColorCorrectionEffect")
		colorCorrection.Parent = Lighting
	end
	colorCorrection.Brightness = 0.02
	colorCorrection.Contrast = 0.12
	colorCorrection.Saturation = 0.14
	colorCorrection.TintColor = Color3.fromRGB(255, 250, 244)

	local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if not sunRays then
		sunRays = Instance.new("SunRaysEffect")
		sunRays.Parent = Lighting
	end
	sunRays.Intensity = 0.12
	sunRays.Spread = 0.9
end

-- ============================================================
-- Табло лидеров
-- ============================================================

local function buildLeaderboard(folder, position, facing)
	local stand = newPart({
		Name = "LeaderboardStand",
		Size = Vector3.new(1.6, 20, 1.6),
		Position = position + Vector3.new(0, 10, 0),
		Color = PALETTE.StoneDark,
		Material = Enum.Material.Metal,
		CanCollide = true,
	}, folder)

	local board = newPart({
		Name = "Leaderboard",
		Size = Vector3.new(24, 15, 1.2),
		CFrame = CFrame.new(position + Vector3.new(0, 25, 0), facing),
		Color = Color3.fromRGB(24, 28, 38),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	}, folder)

	local surface = Instance.new("SurfaceGui")
	surface.Name = "BoardGui"
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(640, 400)
	surface.LightInfluence = 0
	surface.Adornee = board
	surface.Parent = board

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(16, 19, 27)
	frame.BorderSizePixel = 0
	frame.Parent = surface

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = "🏆 ЛУЧШИЕ ВОРЫ ЯИЦ"
	title.TextScaled = true
	title.TextColor3 = PALETTE.Gold
	title.Parent = frame

	local list = Instance.new("TextLabel")
	list.Position = UDim2.new(0.05, 0, 0.19, 0)
	list.Size = UDim2.new(0.9, 0, 0.76, 0)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.GothamBold
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.TextSize = 22
	list.TextWrapped = true
	list.TextColor3 = Color3.fromRGB(238, 242, 255)
	list.Text = "Ждём игроков..."
	list.Parent = frame

	return list
end

-- ============================================================
-- ГЛАВНАЯ СБОРКА
-- ============================================================

function Map.build()
	local oldMap = Workspace:FindFirstChild("EggGame")
	if oldMap then
		oldMap:Destroy()
	end

	-- Убираем всё лишнее: стандартные объекты и статичное превью мира,
	-- которое лежало в файле для отображения без запуска игры
	for _, child in ipairs(Workspace:GetChildren()) do
		local name = child.Name
		if name == "Baseplate"
			or name == "SpawnLocation"
			or name == "FallbackFloor"
			or name == "FallbackSpawn"
			or name == "EggGamePreview" then
			child:Destroy()
		end
	end

	setupLighting()

	local root = Instance.new("Folder")
	root.Name = "EggGame"
	root.Parent = Workspace

	local function folder(name)
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = root
		return f
	end

	local terrainFolder = folder("Terrain")
	local marketFolder = folder("Market")
	local basesFolder = folder("Bases")
	local natureFolder = folder("Nature")
	local eggsFolder = folder("Eggs")
	local vaultEggsFolder = folder("VaultEggs")
	local carriedFolder = folder("Carried")

	buildTerrain(terrainFolder)
	buildMarket(marketFolder)

	local bases = buildBases(basesFolder)

	buildNature(natureFolder)

	-- Табло ставим сбоку от рынка, лицом к спавну
	local boardPos = Vector3.new(-Config.MarketRadius - 14, 0, 4)
	local leaderboardList = buildLeaderboard(
		marketFolder,
		boardPos,
		Vector3.new(0, boardPos.Y + 25, 0)
	)

	return {
		Root = root,
		Terrain = terrainFolder,
		Market = marketFolder,
		BasesFolder = basesFolder,
		Nature = natureFolder,
		Eggs = eggsFolder,
		VaultEggs = vaultEggsFolder,
		Carried = carriedFolder,
		BasesData = bases,
		MarketCenter = Vector3.new(0, 0, 0),
		LeaderboardList = leaderboardList,
	}
end

-- ============================================================
-- АНИМАЦИЯ МИРА
-- ============================================================

--[[
	Одна функция на весь мир: вращает статую, мерцает кострами,
	пульсирует фонарями. Запускается один раз, работает на RunService.

	CFrame статуи и Transparency меняются на сервере — клиенты видят
	результат без задержек, потому что части Anchored.
]]
function Map.startAnimations()
	local RunService = game:GetService("RunService")

	local elapsed = 0

	-- Базовые значения, чтобы мерцание было вокруг них
	local fireBase = {}
	for index, light in ipairs(Map.AnimatedFires) do
		fireBase[index] = light.Brightness or 1.5
	end

	local lanternBase = {}
	for index, bulb in ipairs(Map.AnimatedLanterns) do
		lanternBase[index] = bulb.Color or PALETTE.LanternGlow
	end

	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt

		-- 1. Статуя медленно вращается
		local statue = Map.Statue
		if statue and statue.Parent then
			statue.CFrame = CFrame.new(statue.Position)
				* CFrame.Angles(0, elapsed * 0.55, math.rad(12 * math.sin(elapsed * 0.6)))
		end

		-- 2. Костры мерцают (яркость + лёгкое покачивание)
		for index, light in ipairs(Map.AnimatedFires) do
			if light.Parent then
				local base = fireBase[index] or 1.5
				local wobble = math.sin(elapsed * 7.3 + index * 1.7) * 0.28
					+ math.sin(elapsed * 13.1 + index * 2.9) * 0.14
				light.Brightness = math.max(0.2, base + wobble)
			end
		end

		-- 3. Пламя чуть «дышит»
		for index, flame in ipairs(Map.AnimatedFlames) do
			if flame.Parent then
				local pulse = 1 + math.sin(elapsed * 5.5 + index * 2.1) * 0.09
				flame.Size = Vector3.new(1.9, 1.9, 1.9) * pulse
			end
		end

		-- 4. Лампочки гирлянды плавно перемигиваются
		for index, bulb in ipairs(Map.AnimatedLanterns) do
			if bulb.Parent then
				local base = lanternBase[index] or PALETTE.LanternGlow
				local phase = math.sin(elapsed * 2.2 + index * 0.9) * 0.5 + 0.5
				bulb.Color = base:Lerp(Color3.fromRGB(255, 252, 236), phase * 0.45)
			end
		end
	end)
end

return Map
]]></ProtectedString>
			<bool name="IsPlugin">false</bool>
		</Properties>
	</Item>
	<Item class="ModuleScript" referent="RBX4">
		<Properties>
			<string name="Name">EggGameData</string>
			<ProtectedString name="Source"><![CDATA[--[[
	EggGameData — данные игроков, сохранение и покупка улучшений.

	Место в Studio: ServerScriptService -> ModuleScript "EggGameData"

	Внутри хранит таблицу:
	{
		Coins = 0,
		TotalEarned = 0,
		EggsCollected = 0,
		EggsStolen = 0,
		EggsLost = 0,
		Levels = { Backpack = 0, Speed = 0, Magnet = 0, Steal = 0, Vault = 0, Income = 0 },
	}
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("EggGameConfig"))

local Data = {}

local store = nil
local storeBlocked = false

local cache = {}       -- [Player] = data
local loaded = {}      -- [Player] = true

-- ============================================================
-- ХРАНИЛИЩЕ
-- ============================================================

local function getStore()
	if store then
		return store
	end
	if storeBlocked then
		return nil
	end

	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.SaveFolder)
	end)

	if ok and result then
		store = result
		return store
	end

	storeBlocked = true
	warn("[EggGame] DataStore недоступен — прогресс не сохраняется. " ..
		"В Studio включи Game Settings -> Security -> Enable Studio Access to API Services. Ошибка: " .. tostring(result))
	return nil
end

local function defaultData()
	local levels = {}
	for upgradeName in pairs(Config.Upgrades) do
		levels[upgradeName] = 0
	end

	return {
		Coins = Config.StartingCoins,
		TotalEarned = 0,
		EggsCollected = 0,
		EggsStolen = 0,
		EggsLost = 0,
		BaseId = nil,
		Levels = levels,
	}
end

-- Приводим сохранение к актуальной схеме, защищаемся от мусора в данных
local function sanitize(raw)
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end

	data.Coins = math.clamp(tonumber(raw.Coins) or 0, 0, 1e12)
	data.TotalEarned = math.max(0, tonumber(raw.TotalEarned) or 0)
	data.EggsCollected = math.max(0, tonumber(raw.EggsCollected) or 0)
	data.EggsStolen = math.max(0, tonumber(raw.EggsStolen) or 0)
	data.EggsLost = math.max(0, tonumber(raw.EggsLost) or 0)

	if raw.BaseId ~= nil then
		local baseId = math.floor(tonumber(raw.BaseId) or 0)
		if baseId >= 1 and baseId <= Config.BasesCount then
			data.BaseId = baseId
		end
	end

	if type(raw.Levels) == "table" then
		for upgradeName, upgradeConfig in pairs(Config.Upgrades) do
			local level = math.floor(tonumber(raw.Levels[upgradeName]) or 0)
			data.Levels[upgradeName] = math.clamp(level, 0, upgradeConfig.MaxLevel)
		end
	end

	return data
end

-- ============================================================
-- БАЗОВЫЕ ОПЕРАЦИИ
-- ============================================================

function Data.get(player)
	return cache[player]
end

function Data.isLoaded(player)
	return loaded[player] == true
end

function Data.getCoins(player)
	local data = cache[player]
	return data and data.Coins or 0
end

function Data.addCoins(player, amount)
	local data = cache[player]
	if not data then
		return
	end
	data.Coins = math.max(0, data.Coins + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
end

function Data.addStat(player, statName, amount)
	local data = cache[player]
	if not data or type(data[statName]) ~= "number" then
		return
	end
	data[statName] += amount
end

function Data.getLevel(player, upgradeName)
	local data = cache[player]
	if not data then
		return 0
	end
	return data.Levels[upgradeName] or 0
end

-- Итоговое значение улучшения по его текущему уровню
function Data.getUpgradeValue(player, upgradeName)
	local upgradeConfig = Config.Upgrades[upgradeName]
	if not upgradeConfig then
		return 0
	end
	return upgradeConfig.BaseValue + Data.getLevel(player, upgradeName) * upgradeConfig.PerLevel
end

-- Цена следующего уровня (nil, если уже максимум)
function Data.getUpgradeCost(player, upgradeName)
	local upgradeConfig = Config.Upgrades[upgradeName]
	if not upgradeConfig then
		return nil
	end

	local level = Data.getLevel(player, upgradeName)
	if level >= upgradeConfig.MaxLevel then
		return nil
	end

	return math.floor(upgradeConfig.BaseCost * (upgradeConfig.CostGrowth ^ level) + 0.5)
end

-- Возвращает success, message
function Data.purchaseUpgrade(player, upgradeName)
	local upgradeConfig = Config.Upgrades[upgradeName]
	if not upgradeConfig then
		return false, "Такого улучшения нет"
	end

	local data = cache[player]
	if not data then
		return false, "Данные ещё грузятся"
	end

	local level = data.Levels[upgradeName] or 0
	if level >= upgradeConfig.MaxLevel then
		return false, "Уже максимальный уровень"
	end

	local cost = Data.getUpgradeCost(player, upgradeName)
	if not cost then
		return false, "Уже максимальный уровень"
	end

	if data.Coins < cost then
		return false, "Не хватает монет"
	end

	data.Coins -= cost
	data.Levels[upgradeName] = level + 1

	return true, "Куплено: " .. upgradeConfig.DisplayName
end

-- ============================================================
-- ЗАГРУЗКА И СОХРАНЕНИЕ
-- ============================================================

function Data.load(player)
	local data = nil
	local targetStore = getStore()

	if targetStore then
		local key = "Player_" .. tostring(player.UserId)
		local ok, result = pcall(function()
			return targetStore:GetAsync(key)
		end)

		if ok then
			data = sanitize(result)
		else
			warn("[EggGame] Ошибка загрузки данных " .. player.Name .. ": " .. tostring(result))
		end
	end

	cache[player] = data or defaultData()
	loaded[player] = true

	return cache[player]
end

function Data.save(player, isFinal)
	local data = cache[player]
	if not data then
		return
	end

	local targetStore = getStore()
	if not targetStore then
		return
	end

	local payload = {
		Coins = data.Coins,
		TotalEarned = data.TotalEarned,
		EggsCollected = data.EggsCollected,
		EggsStolen = data.EggsStolen,
		EggsLost = data.EggsLost,
		BaseId = data.BaseId,
		Levels = data.Levels,
		DataVersion = Config.DataVersion,
	}

	local key = "Player_" .. tostring(player.UserId)

	local ok, result = pcall(function()
		return targetStore:UpdateAsync(key, function()
			return payload
		end)
	end)

	if not ok then
		warn("[EggGame] Ошибка сохранения данных " .. player.Name .. ": " .. tostring(result))
	end
end

function Data.release(player)
	Data.save(player, true)
	cache[player] = nil
	loaded[player] = nil
end

function Data.startAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in pairs(cache) do
				if player.Parent then
					task.spawn(function()
						Data.save(player)
					end)
				end
			end
		end
	end)
end

function Data.isStoreAvailable()
	return getStore() ~= nil
end

return Data
]]></ProtectedString>
			<bool name="IsPlugin">false</bool>
		</Properties>
	</Item>
	<Item class="ModuleScript" referent="RBX5">
		<Properties>
			<string name="Name">EggGameCore</string>
			<ProtectedString name="Source"><![CDATA[--[[
	EggGameCore — вся игровая логика на сервере.

	Место в Studio: ServerScriptService -> ModuleScript "EggGameCore"

	ЦИКЛ ИГРЫ
	  1. На рынке в центре постоянно появляются яйца (4 редкости).
	  2. Идёшь по ним — яйца сами запрыгивают в стопку над головой.
	  3. Несёшь на свою базу — яйца сами заносятся на склад.
	  4. Яйца на складе приносят монеты каждую секунду.
	  5. Другие игроки могут украсть яйца у тебя из рюкзака (зажать E рядом)
	     или обокрасть твой склад (зажать E у склада).
	  6. Монеты тратятся в магазине на улучшения.

	Клиент ничего не решает — только просит, сервер проверяет всё сам.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("EggGameConfig"))
local function findModule(name)
	local direct = script.Parent and script.Parent:FindFirstChild(name)
	if direct then
		return direct
	end
	local service = game:GetService("ServerScriptService")
	local anywhere = service:FindFirstChild(name, true)
	if anywhere then
		return anywhere
	end
	return script.Parent:WaitForChild(name)
end

local Data = require(findModule("EggGameData"))
local Map = require(findModule("EggGameMap"))

local Core = {}

local RNG = Random.new()

-- ============================================================
-- СОСТОЯНИЕ
-- ============================================================

local state = {
	map = nil,
	bases = {},         -- [baseId] = baseState
	playerBase = {},    -- [Player] = baseId
	groundEggs = {},    -- { { Part = part, Type = string }, ... }
	carried = {},       -- [Player] = { Parts = {}, Types = {}, Count, LockUntil }
	cooldowns = {},     -- [Player] = { Raid = number }
	depositing = {},    -- [Player] = true
	vaultFullWarned = {},
	remotes = {},
}

-- ============================================================
-- МЕЛКИЕ УТИЛИТЫ
-- ============================================================

local function getRoot(player)
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function horizontalDistance(a, b)
	local delta = a - b
	return Vector3.new(delta.X, 0, delta.Z).Magnitude
end

local function getCooldown(player)
	local cooldown = state.cooldowns[player]
	if not cooldown then
		cooldown = { Raid = 0 }
		state.cooldowns[player] = cooldown
	end
	return cooldown
end

local function getCarried(player)
	local carried = state.carried[player]
	if not carried then
		carried = { Parts = {}, Types = {}, Count = 0, LockUntil = 0 }
		state.carried[player] = carried
	end
	return carried
end

local function getBackpackCapacity(player)
	return math.max(1, math.floor(Data.getUpgradeValue(player, "Backpack")))
end

local function getVaultCapacity(base)
	if #base.Owners == 0 then
		return Config.VaultCapacityBase
	end

	local best = Config.VaultCapacityBase
	for _, owner in ipairs(base.Owners) do
		best = math.max(best, math.floor(Data.getUpgradeValue(owner, "Vault")))
	end
	return best
end

local function pickEggType()
	local weightSum = 0
	for _, eggType in pairs(Config.EggTypes) do
		weightSum += eggType.Weight
	end

	local roll = RNG:NextNumber() * weightSum
	for name, eggType in pairs(Config.EggTypes) do
		roll -= eggType.Weight
		if roll <= 0 then
			return name
		end
	end

	return "Common"
end

-- ============================================================
-- УВЕДОМЛЕНИЯ
-- ============================================================

--[[
	Безопасная отправка на клиент.

	Если remote ещё не создан, или клиент отключился, или (в редких случаях)
	remote не является RemoteEvent — сервер НЕ должен падать.
	Любая ошибка здесь не должна ломать игровую логику.
]]
local function fireClient(remoteName, player, ...)
	local remote = state.remotes[remoteName]

	if not remote or not player or not player.Parent then
		return false
	end

	local args = table.pack(...)
	local ok = pcall(function()
		remote:FireClient(player, table.unpack(args, 1, args.n))
	end)

	return ok
end

-- То же для RemoteFunction, отвечающего клиенту
Core.fireClient = fireClient

function Core.notify(player, text, color)
	fireClient("Notify", player, text, color)
end

-- ============================================================
-- БАЗЫ: ВИЗУАЛ И НАЗНАЧЕНИЕ
-- ============================================================

local function vaultValueOf(base)
	local value = 0
	for eggTypeName, count in pairs(base.Vault) do
		local eggType = Config.EggTypes[eggTypeName]
		if eggType then
			value += eggType.Value * count
		end
	end
	return value
end

local function getBaseIncomePerSecond(base, player)
	if base.VaultTotal <= 0 then
		return 0
	end

	local ownerCount = math.max(1, #base.Owners)
	local rate = vaultValueOf(base) * Config.IncomeRate

	if player then
		return (rate * Data.getUpgradeValue(player, "Income")) / ownerCount
	end

	local total = 0
	for _, owner in ipairs(base.Owners) do
		total += (rate * Data.getUpgradeValue(owner, "Income")) / ownerCount
	end
	return total
end

Core.getBaseIncomePerSecond = getBaseIncomePerSecond

local function updateBaseVisuals(base)
	local owners = base.Owners
	local ownerCount = #owners

	if ownerCount == 0 then
		base.Platform.Color = Config.Colors.FreeBase
		base.Glow.Color = Config.Colors.FreeBase
		base.SignLabel.Text = "Свободная база"
		base.SignLabel.TextColor3 = Color3.fromRGB(225, 228, 235)
		base.VaultLabel.Text = string.format("🏦 %d", base.VaultTotal)
		base.VaultTop.Color = Color3.fromRGB(132, 110, 82)
		base.VaultGlow.Color = Config.Colors.FreeBase
		return
	end

	base.Platform.Color = Config.Colors.MyBase
	base.Glow.Color = Config.Colors.MyBase
	base.VaultTop.Color = Color3.fromRGB(150, 122, 88)
	base.VaultGlow.Color = Config.Colors.Vault

	local names = {}
	for index, owner in ipairs(owners) do
		if index <= 3 then
			table.insert(names, owner.DisplayName)
		end
	end
	if ownerCount > 3 then
		table.insert(names, "+" .. (ownerCount - 3))
	end

	base.SignLabel.Text = table.concat(names, ", ")
	base.SignLabel.TextColor3 = Color3.fromRGB(200, 255, 220)

	local rate = getBaseIncomePerSecond(base, owners[1])
	base.VaultLabel.Text = string.format("🏦 %d / %d   💰 %.1f/сек", base.VaultTotal, getVaultCapacity(base), rate)
end

-- ============================================================
-- СИНХРОНИЗАЦИЯ С КЛИЕНТОМ
-- ============================================================

function Core.syncCoins(player)
	local base = Core.getBaseForPlayerFor(player)
	local income = base and getBaseIncomePerSecond(base, player) or 0

	fireClient("CoinsUpdate", player, Data.getCoins(player), income)
end

function Core.syncCarried(player)
	local carried = getCarried(player)
	fireClient("CarriedUpdate", player, carried.Count, getBackpackCapacity(player), carried.Types)
end

function Core.syncBaseInfo(player)
	local base = Core.getBaseForPlayerFor(player)
	if not base then
		fireClient("BaseInfo", player, nil)
		return
	end

	fireClient("BaseInfo", player, {
		BaseId = base.Id,
		VaultTotal = base.VaultTotal,
		Capacity = getVaultCapacity(base),
		Income = getBaseIncomePerSecond(base, player),
		Owners = #base.Owners,
	})
end

-- ============================================================
-- НАЗНАЧЕНИЕ БАЗ
-- ============================================================

function Core.getBaseForPlayerFor(player)
	local baseId = state.playerBase[player]
	if not baseId then
		return nil
	end
	return state.bases[baseId]
end

function Core.assignBase(player)
	local existing = state.playerBase[player]
	if existing then
		return existing
	end

	-- Игрок возвращается: отдаём ту же базу, если она ещё свободна или уже его
	local data = Data.get(player)
	local preferredId = data and data.BaseId

	if preferredId then
		local preferred = state.bases[preferredId]
		if preferred then
			local ownedByOther = false
			for _, owner in ipairs(preferred.Owners) do
				if owner ~= player then
					ownedByOther = true
					break
				end
			end

			if not ownedByOther then
				local alreadyThere = false
				for _, owner in ipairs(preferred.Owners) do
					if owner == player then
						alreadyThere = true
						break
					end
				end

				if not alreadyThere then
					table.insert(preferred.Owners, player)
				end

				state.playerBase[player] = preferred.Id
				updateBaseVisuals(preferred)
				Core.syncBaseInfo(player)
				return preferred.Id
			end
		end
	end

	-- Ищем базу с наименьшим числом владельцев (сначала пустые)
	local bestBase, bestCount = nil, math.huge
	for _, base in ipairs(state.map.BasesData) do
		local count = #base.Owners
		if count < bestCount then
			bestCount, bestBase = count, base
		end
		if count == 0 then
			break
		end
	end

	if not bestBase then
		return nil
	end

	table.insert(bestBase.Owners, player)
	state.playerBase[player] = bestBase.Id

	local data = Data.get(player)
	if data then
		data.BaseId = bestBase.Id
	end

	updateBaseVisuals(bestBase)

	Core.syncBaseInfo(player)

	return bestBase.Id
end

function Core.releaseBase(player, keepPreference)
	local baseId = state.playerBase[player]
	state.playerBase[player] = nil

	if not baseId then
		return
	end

	local base = state.bases[baseId]
	if not base then
		return
	end

	for index, owner in ipairs(base.Owners) do
		if owner == player then
			table.remove(base.Owners, index)
			break
		end
	end

	base.RateAccum[player] = nil
	updateBaseVisuals(base)

	if not keepPreference then
		local data = Data.get(player)
		if data then
			data.BaseId = nil
		end
	end
end

-- ============================================================
-- ЯЙЦА НА РЫНКЕ
-- ============================================================

function Core.spawnGroundEgg()
	if #state.groundEggs >= Config.MaxGroundEggs then
		return nil
	end

	local offset = Map.randomPointInDisc(Config.MarketRadius - 6)

	-- Не кладём яйца друг на друга
	for _ = 1, 6 do
		local tooClose = false
		for _, groundEgg in ipairs(state.groundEggs) do
			if groundEgg.Part and groundEgg.Part.Parent then
				local delta = groundEgg.Part.Position - offset
				if Vector3.new(delta.X, 0, delta.Z).Magnitude < 3.4 then
					tooClose = true
					break
				end
			end
		end
		if not tooClose then
			break
		end
		offset = Map.randomPointInDisc(Config.MarketRadius - 6)
	end

	local eggTypeName = pickEggType()
	local part = Map.makeEggPart(eggTypeName, state.map.Eggs)
	part.Position = Vector3.new(offset.X, 2.3, offset.Z)

	local groundEgg = { Part = part, Type = eggTypeName }
	table.insert(state.groundEggs, groundEgg)

	return groundEgg
end

local function removeGroundEgg(groundEgg)
	for index, candidate in ipairs(state.groundEggs) do
		if candidate == groundEgg then
			table.remove(state.groundEggs, index)
			return
		end
	end
end

-- ============================================================
-- РЮКЗАК: СТОПКА НАД ГОЛОВОЙ
-- ============================================================

local function refreshStack(player)
	local carried = state.carried[player]
	if not carried then
		return
	end

	local root = getRoot(player)
	if not root then
		return
	end

	local columns = Config.StackColumns
	local shown = 0

	for _, part in ipairs(carried.Parts) do
		if part and part.Parent then
			shown += 1

			if shown <= Config.MaxVisibleStack then
				local row = math.floor((shown - 1) / columns)
				local column = (shown - 1) % columns
				local columnOffset = (column - (columns - 1) / 2) * Config.StackSpread

				local offset = Vector3.new(
					columnOffset,
					Config.StackBaseHeight + row * Config.StackHeight,
					-Config.StackBackOffset
				)

				part.CFrame = root.CFrame * CFrame.new(offset)
				part.Anchored = true
				part.CanCollide = false
				part.Transparency = 0
			else
				part.Transparency = 1
			end
		end
	end
end

local function refreshAllStacks()
	for player in pairs(state.carried) do
		refreshStack(player)
	end
end

function Core.addEggToBackpack(player, eggTypeName, count)
	count = count or 1

	local carried = getCarried(player)
	local capacity = getBackpackCapacity(player)

	local added = 0
	for _ = 1, count do
		if carried.Count >= capacity then
			break
		end

		local part = Map.makeEggPart(eggTypeName, state.map.Carried)
		part.Size = part.Size * Config.CarriedEggScale
		part.Anchored = true

		table.insert(carried.Parts, part)
		carried.Types[eggTypeName] = (carried.Types[eggTypeName] or 0) + 1
		carried.Count += 1
		added += 1
	end

	if added > 0 then
		carried.LockUntil = os.clock() + Config.StealLockTime
		refreshStack(player)
		Core.syncCarried(player)
	end

	return added
end

-- Убирает count яиц из рюкзака. Возвращает ({[type]=count}, всего)
function Core.takeEggsFromBackpack(player, count)
	local carried = state.carried[player]
	if not carried then
		return {}, 0
	end

	local taken = {}
	local takenTotal = 0

	for _ = 1, count do
		if carried.Count <= 0 then
			break
		end

		local part = table.remove(carried.Parts)
		if part then
			part:Destroy()
		end

		-- Берём тип, которого в рюкзаке больше всего
		local chosenType, chosenCount = nil, 0
		for eggTypeName, typeCount in pairs(carried.Types) do
			if typeCount > chosenCount then
				chosenType, chosenCount = eggTypeName, typeCount
			end
		end

		if chosenType then
			carried.Types[chosenType] -= 1
			if carried.Types[chosenType] <= 0 then
				carried.Types[chosenType] = nil
			end
			taken[chosenType] = (taken[chosenType] or 0) + 1
		end

		carried.Count -= 1
		takenTotal += 1
	end

	if takenTotal > 0 then
		refreshStack(player)
		Core.syncCarried(player)
	end

	return taken, takenTotal
end

function Core.dropAllCarried(player, position)
	local carried = state.carried[player]
	if not carried or carried.Count <= 0 then
		return
	end

	local root = getRoot(player)
	local dropPosition = position or (root and root.Position) or Vector3.new(0, 2, 0)

	for _, part in ipairs(carried.Parts) do
		if part then
			part:Destroy()
		end
	end
	carried.Parts = {}

	for eggTypeName, count in pairs(carried.Types) do
		for _ = 1, count do
			local offset = Map.randomPointInDisc(5)
			local part = Map.makeEggPart(eggTypeName, state.map.Eggs)
			part.Position = dropPosition + offset + Vector3.new(0, 1.8, 0)
			table.insert(state.groundEggs, { Part = part, Type = eggTypeName })
		end
	end

	carried.Types = {}
	carried.Count = 0
	Core.syncCarried(player)
end

function Core.getCarriedCount(player)
	local carried = state.carried[player]
	return carried and carried.Count or 0
end

-- ============================================================
-- ПОДБОР ЯИЦ (автоматический)
-- ============================================================

local function isInsideOwnBase(player)
	local base = Core.getBaseForPlayerFor(player)
	local root = getRoot(player)
	if not base or not root then
		return false
	end
	return horizontalDistance(root.Position, base.Center) <= Config.BaseZoneRadius + 1
end

local function startPickupLoop()
	task.spawn(function()
		while true do
			task.wait(0.15)

			for _, player in ipairs(Players:GetPlayers()) do
				local root = getRoot(player)
				local carried = state.carried[player]

				if root and carried and Data.isLoaded(player) and carried.Count < getBackpackCapacity(player) then
					-- Если стоишь на своей базе, яйца не подбираем — они сразу уходят в склад
					if not isInsideOwnBase(player) then
						local radius = Config.PickupRadius
						local magnetLevel = Data.getLevel(player, "Magnet")
						if magnetLevel > 0 then
							radius += Data.getUpgradeValue(player, "Magnet")
						end

						local nearest, nearestDistance = nil, math.huge
						for _, groundEgg in ipairs(state.groundEggs) do
							local part = groundEgg.Part
							if part and part.Parent then
								local horizontal = horizontalDistance(part.Position, root.Position)
								local vertical = math.abs(part.Position.Y - root.Position.Y)

								if horizontal <= radius and vertical <= 14 and horizontal < nearestDistance then
									nearest, nearestDistance = groundEgg, horizontal
								end
							end
						end

						if nearest then
							local eggTypeName = nearest.Type
							removeGroundEgg(nearest)
							if nearest.Part then
								nearest.Part:Destroy()
							end

							local added = Core.addEggToBackpack(player, eggTypeName, 1)
							if added > 0 then
								Data.addStat(player, "EggsCollected", 1)
							end
						end
					end
				end
			end
		end
	end)
end

-- ============================================================
-- СКЛАД: ВИЗУАЛ И СДАЧА
-- ============================================================

function Core.refreshVaultVisuals(base)
	for _, part in ipairs(base.VisualEggs) do
		if part then
			part:Destroy()
		end
	end
	base.VisualEggs = {}

	local maxVisual = 12
	local shown = 0

	for eggTypeName, count in pairs(base.Vault) do
		local toShow = math.min(count, maxVisual - shown)

		for index = 1, toShow do
			local part = Map.makeEggPart(eggTypeName, state.map.VaultEggs)
			part.Size = part.Size * Config.VaultEggScale
			part.Anchored = true

			local row = math.floor(shown / 4)
			local column = shown % 4
			local jitter = (RNG:NextNumber() - 0.5) * 0.5

			part.Position = base.Center + Vector3.new(
				(column - 1.5) * 2.1,
				5.3 + row * 1.3,
				-1.4 + (row % 2) * 0.8 + jitter
			)

			table.insert(base.VisualEggs, part)
			shown += 1
		end

		if shown >= maxVisual then
			break
		end
	end
end

function Core.startDeposit(player)
	if state.depositing[player] then
		return
	end
	state.depositing[player] = true

	task.spawn(function()
		while true do
			task.wait(Config.DepositTime)

			local carried = state.carried[player]
			if not carried or carried.Count <= 0 then
				break
			end

			local base = Core.getBaseForPlayerFor(player)
			if not base or not isInsideOwnBase(player) then
				break
			end

			if base.VaultTotal >= getVaultCapacity(base) then
				if not state.vaultFullWarned[player] then
					state.vaultFullWarned[player] = true
					Core.notify(player, "Склад полон! Улучши «Склад» в магазине", Color3.fromRGB(255, 170, 120))
				end
				break
			end

			state.vaultFullWarned[player] = nil

			local taken, takenTotal = Core.takeEggsFromBackpack(player, 1)
			if takenTotal <= 0 then
				break
			end

			for eggTypeName, count in pairs(taken) do
				base.Vault[eggTypeName] = (base.Vault[eggTypeName] or 0) + count
				base.VaultTotal += count
			end

			Core.refreshVaultVisuals(base)
			updateBaseVisuals(base)

			Core.syncCarried(player)
			Core.syncBaseInfo(player)
		end

		state.depositing[player] = nil
	end)
end

-- ============================================================
-- КРАЖА С ЧУЖОГО СКЛАДА
-- ============================================================

function Core.tryRaid(player, baseId)
	baseId = tonumber(baseId)
	if not baseId then
		return false, "Неверная база"
	end

	local base = state.bases[baseId]
	if not base then
		return false, "Нет такой базы"
	end

	if not Data.isLoaded(player) then
		return false, "Подожди загрузку"
	end

	for _, owner in ipairs(base.Owners) do
		if owner == player then
			return false, "Это твоя база"
		end
	end

	if base.VaultTotal <= 0 then
		return false, "Склад пуст"
	end

	local cooldown = getCooldown(player)
	if os.clock() < cooldown.Raid then
		return false, "Рано"
	end

	local root = getRoot(player)
	if not root then
		return false, "Нет персонажа"
	end

	if horizontalDistance(root.Position, base.Center) > Config.BaseZoneRadius + 10 then
		return false, "Подойди ближе"
	end

	local carried = getCarried(player)
	local capacity = getBackpackCapacity(player) - carried.Count
	if capacity <= 0 then
		return false, "Рюкзак полон"
	end

	local stealPower = math.max(1, math.floor(Data.getUpgradeValue(player, "Steal")))
	local amount = math.min(stealPower, capacity, base.VaultTotal)

	local takenTotal = 0
	local takenValue = 0

	-- Забираем самые дорогие яйца
	for _ = 1, amount do
		local bestType, bestValue = nil, -1
		for eggTypeName, count in pairs(base.Vault) do
			if count > 0 then
				local eggType = Config.EggTypes[eggTypeName]
				if eggType and eggType.Value > bestValue then
					bestType, bestValue = eggTypeName, eggType.Value
				end
			end
		end

		if not bestType then
			break
		end

		base.Vault[bestType] -= 1
		if base.Vault[bestType] <= 0 then
			base.Vault[bestType] = nil
		end
		base.VaultTotal -= 1

		Core.addEggToBackpack(player, bestType, 1)
		takenTotal += 1
		takenValue += bestValue
	end

	cooldown.Raid = os.clock() + Config.StealCooldown

	if takenTotal <= 0 then
		return false, "Не удалось ничего взять"
	end

	Core.refreshVaultVisuals(base)
	updateBaseVisuals(base)
	Data.addStat(player, "EggsStolen", takenTotal)

	Core.notify(player, string.format("🥷 Украдено %d яиц (≈%d 💰)", takenTotal, takenValue), Color3.fromRGB(255, 210, 90))

	for _, owner in ipairs(base.Owners) do
		Data.addStat(owner, "EggsLost", takenTotal)
		Core.notify(owner, string.format("⚠️ %s украл %d яиц с твоей базы!", player.DisplayName, takenTotal), Color3.fromRGB(255, 110, 100))
		Core.syncBaseInfo(owner)
	end

	Core.syncBaseInfo(player)
	return true, "Украдено " .. takenTotal
end

-- ============================================================
-- КРАЖА ИЗ РЮКЗАКА ИГРОКА
-- ============================================================

function Core.tryStealFromPlayer(thief, victim)
	if thief == victim then
		return false, "Себя обкрадывать не нужно"
	end

	if not Data.isLoaded(thief) or not Data.isLoaded(victim) then
		return false, "Подожди загрузку"
	end

	local cooldown = getCooldown(thief)
	if os.clock() < cooldown.Raid then
		return false, "Рано"
	end

	local victimCarried = state.carried[victim]
	if not victimCarried or victimCarried.Count <= 0 then
		Core.notify(thief, "У него пусто", Color3.fromRGB(200, 210, 230))
		return false, "У него пусто"
	end

	if os.clock() < victimCarried.LockUntil then
		Core.notify(thief, "Он держит яйца крепко — подожди", Color3.fromRGB(255, 190, 120))
		return false, "Он держит крепко"
	end

	local thiefRoot = getRoot(thief)
	local victimRoot = getRoot(victim)
	if not thiefRoot or not victimRoot then
		return false, "Далеко"
	end

	if horizontalDistance(thiefRoot.Position, victimRoot.Position) > 10 then
		return false, "Подойди ближе"
	end

	local carried = getCarried(thief)
	local capacity = getBackpackCapacity(thief) - carried.Count
	if capacity <= 0 then
		Core.notify(thief, "Твой рюкзак полон", Color3.fromRGB(255, 170, 120))
		return false, "Твой рюкзак полон"
	end

	local stealPower = math.max(1, math.floor(Data.getUpgradeValue(thief, "Steal")))
	local amount = math.min(stealPower, capacity, victimCarried.Count)

	local taken, takenTotal = Core.takeEggsFromBackpack(victim, amount)
	if takenTotal <= 0 then
		return false, "Не удалось"
	end

	for eggTypeName, count in pairs(taken) do
		Core.addEggToBackpack(thief, eggTypeName, count)
	end

	cooldown.Raid = os.clock() + Config.StealCooldown

	Data.addStat(thief, "EggsStolen", takenTotal)
	Data.addStat(victim, "EggsLost", takenTotal)

	Core.notify(thief, string.format("🥷 Украл %d яиц у %s!", takenTotal, victim.DisplayName), Color3.fromRGB(255, 210, 90))
	Core.notify(victim, string.format("⚠️ %s украл у тебя %d яиц!", thief.DisplayName, takenTotal), Color3.fromRGB(255, 110, 100))

	return true, "Украдено " .. takenTotal
end

local function attachPlayerStealPrompt(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end

	local oldPrompt = character:FindFirstChild("StealFromMe")
	if oldPrompt then
		oldPrompt:Destroy()
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StealFromMe"
	prompt.ActionText = "Украсть яйца"
	prompt.ObjectText = player.DisplayName
	prompt.HoldDuration = Config.PlayerStealHoldTime
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = root

	prompt.Triggered:Connect(function(thief)
		Core.tryStealFromPlayer(thief, player)
	end)
end

-- ============================================================
-- ДОХОД
-- ============================================================

local function startIncomeLoop()
	task.spawn(function()
		while true do
			task.wait(1)

			for _, base in ipairs(state.map.BasesData) do
				local ownerCount = #base.Owners

				if ownerCount > 0 and base.VaultTotal > 0 then
					local rate = vaultValueOf(base) * Config.IncomeRate
					local totalIncome = 0

					for _, owner in ipairs(base.Owners) do
						local incomeMultiplier = Data.getUpgradeValue(owner, "Income")
						local share = (rate * incomeMultiplier) / ownerCount

						base.RateAccum[owner] = (base.RateAccum[owner] or 0) + share

						local whole = math.floor(base.RateAccum[owner])
						if whole > 0 then
							base.RateAccum[owner] -= whole
							Data.addCoins(owner, whole)
						end

						totalIncome += share
					end

					base.IncomePerSecond = totalIncome
					updateBaseVisuals(base)

					for _, owner in ipairs(base.Owners) do
						Core.syncCoins(owner)
						Core.syncBaseInfo(owner)
					end
				else
					base.IncomePerSecond = 0
					if base.VaultTotal == 0 then
						base.RateAccum = {}
					end
				end
			end
		end
	end)
end

-- ============================================================
-- СКОРОСТЬ ПЕРСОНАЖА
-- ============================================================

local function startSpeedLoop()
	task.spawn(function()
		while true do
			task.wait(0.5)

			for _, player in ipairs(Players:GetPlayers()) do
				if Data.isLoaded(player) then
					local character = player.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")

					if humanoid then
						local carried = state.carried[player]
						local penalty = 0

						if carried and carried.Count > 0 then
							penalty = math.min(6, carried.Count * 0.3)
						end

						local targetSpeed = math.max(8, Data.getUpgradeValue(player, "Speed") - penalty)

						if math.abs(humanoid.WalkSpeed - targetSpeed) > 0.2 then
							humanoid.WalkSpeed = targetSpeed
						end
					end
				end
			end
		end
	end)
end

-- ============================================================
-- ТАБЛО ЛИДЕРОВ
-- ============================================================

local function startLeaderboardLoop()
	task.spawn(function()
		while true do
			task.wait(3)

			local board = state.map and state.map.LeaderboardList
			if board then
				local entries = {}
				for _, player in ipairs(Players:GetPlayers()) do
					if Data.isLoaded(player) then
						local data = Data.get(player)
						table.insert(entries, {
							Name = player.DisplayName,
							Score = data.TotalEarned,
						})
					end
				end

				table.sort(entries, function(a, b)
					return a.Score > b.Score
				end)

				local lines = {}
				for index = 1, math.min(8, #entries) do
					local entry = entries[index]
					local medal = (index == 1 and "🥇")
						or (index == 2 and "🥈")
						or (index == 3 and "🥉")
						or (index .. ".")
					table.insert(lines, string.format("%s  %s  —  %d 💰", medal, entry.Name, math.floor(entry.Score)))
				end

				board.Text = (#lines > 0) and table.concat(lines, "\n") or "Ждём игроков..."
			end
		end
	end)
end

-- ============================================================
-- ЖИЗНЕННЫЙ ЦИКЛ ИГРОКА
-- ============================================================

function Core.onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end

	humanoid.Died:Connect(function()
		task.wait(0.1)
		Core.dropAllCarried(player)
		state.depositing[player] = nil
	end)

	attachPlayerStealPrompt(player, character)
	refreshStack(player)
	Core.syncCarried(player)
end

function Core.cleanupPlayer(player)
	Core.dropAllCarried(player)
	Core.releaseBase(player, true)

	state.carried[player] = nil
	state.cooldowns[player] = nil
	state.depositing[player] = nil
	state.vaultFullWarned[player] = nil
end

-- ============================================================
-- ИНИЦИАЛИЗАЦИЯ
-- ============================================================

local function startStackLoop()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		refreshAllStacks()
	end)
end

function Core.init(mapData, remotes)
	state.map = mapData
	state.remotes = remotes
	state.vaultFullWarned = {}

	for _, base in ipairs(mapData.BasesData) do
		base.RateAccum = {}
		base.IncomePerSecond = 0
		state.bases[base.Id] = base

		updateBaseVisuals(base)
		Core.refreshVaultVisuals(base)

		base.StealPrompt.Triggered:Connect(function(player)
			Core.tryRaid(player, base.Id)
		end)
	end

	-- Наполняем рынок сразу, чтоб не было пусто на старте
	for _ = 1, 12 do
		Core.spawnGroundEgg()
	end

	task.spawn(function()
		while true do
			Core.spawnGroundEgg()
			task.wait(Config.SpawnInterval)
		end
	end)

	startPickupLoop()
	startIncomeLoop()
	startSpeedLoop()
	startLeaderboardLoop()

	-- Автоматическая сдача яиц при входе в свою базу
	task.spawn(function()
		while true do
			task.wait(0.3)

			for _, player in ipairs(Players:GetPlayers()) do
				if Data.isLoaded(player) then
					local carried = state.carried[player]
					if carried and carried.Count > 0 then
						if isInsideOwnBase(player) then
							Core.startDeposit(player)
						end
					end
				end
			end
		end
	end)

	startStackLoop()

	return Core
end

-- Доступ к внутреннему состоянию (для тестов и отладки)
function Core.getCtx()
	return state
end

-- Совместимость: старые вызовы
Core.getBaseForPlayer = Core.getBaseForPlayerFor
Core.spawnEggLoop = function() end

return Core
